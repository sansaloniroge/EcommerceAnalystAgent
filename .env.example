# Copy to .env and fill in.

OPENAI_API_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Admin connection (schema owner) -- used by scripts/load_dataset.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_agent

# Least-privilege connection (SELECT only) -- used by the agent's sql_query
# tool at request time. Never the admin URL above.
AGENT_DB_URL=postgresql://agent_readonly:agent_readonly_local_dev@localhost:5433/ecommerce_agent
